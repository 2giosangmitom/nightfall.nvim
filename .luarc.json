{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "?.lua",
      "?/init.lua",
      "lua/?.lua",
      "lua/?/init.lua",
      "scripts/?.lua",
      "scripts/?/init.lua"
    ]
  },
  "diagnostics": {
    "enable": true,
    "globals": ["vim"]
  },
  "workspace": {
    "library": ["$VIMRUNTIME", "${3rd}/luv/library", "deps/mini.test/lua", "deps/mini.doc/lua"],
    "checkThirdParty": false,
    "ignoreDir": ["deps"]
  }
}
